# Copy to backend/.env and fill in. Never commit the real .env.

# --- Model providers ---
# Every model runs on OpenRouter by default. ANTHROPIC_API_KEY is only needed if you point a
# *_MODEL setting at the Anthropic API directly, or run without an OpenRouter key.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- LangSmith tracing (optional but recommended) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=threadkeeper

# --- App ---
# Optional passcode required in an X-Access-Key header. Leave empty to keep the app open to everyone
# (the current setup: the website does not send a key).
ACCESS_KEY=
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Database: Supabase Postgres, used both locally and on Render.
# Supabase dashboard -> Connect -> "Session pooler" string (not "Direct connection": that one is IPv6-only).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# For offline experiments without Supabase:
# DATABASE_URL=sqlite:///threadkeeper.db

# --- Optional overrides ---
# Ids with a "/" go through OpenRouter; the rest go straight to the Anthropic API.
# PLANNER_MODEL=anthropic/claude-opus-5.5
# WRITER_MODEL=anthropic/claude-sonnet-5.5
# EXTRACTOR_MODEL=anthropic/claude-haiku-4.5
# CRITIC_MODEL=google/gemini-2.5-flash
# EPISODE_COST_CAP_USD=0.25
# MAX_REVISIONS=2
